{
  "name": "fullcalendar-scheduler",
  "version": "7.1.0",
  "title": "FullCalendar Scheduler (Vanilla JS)",
  "description": "FullCalendar Vanilla JS Scheduler package",
  "dependencies": {
    "@full-ui/headless-calendar": "7.1.0",
    "@full-ui/headless-grid": "7.1.0",
    "@fullcalendar/core": "7.1.0",
    "preact": "^10.29.8"
  },
  "peerDependencies": {
    "fullcalendar": "7.1.0",
    "temporal-polyfill": "^1.0.1"
  },
  "type": "module",
  "keywords": [
    "calendar",
    "event",
    "full-sized",
    "fullcalendar",
    "scheduler",
    "resource"
  ],
  "homepage": "https://fullcalendar.io/docs/premium",
  "bugs": "https://fullcalendar.io/reporting-bugs",
  "repository": {
    "type": "git",
    "url": "https://github.com/fullcalendar/fullcalendar-workspace.git",
    "directory": "premium/packages/vanilla-scheduler"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Adam Shaw",
    "email": "arshaw@arshaw.com",
    "url": "http://arshaw.com/"
  },
  "copyright": "2026 Adam Shaw",
  "types": "./index.d.ts",
  "main": "./index.js",
  "unpkg": "./all/global.js",
  "jsdelivr": "./all/global.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./all": {
      "types": "./all/index.d.ts",
      "default": "./all/index.js"
    },
    "./adaptive": {
      "types": "./adaptive.d.ts",
      "default": "./adaptive.js"
    },
    "./resource-daygrid": {
      "types": "./resource-daygrid.d.ts",
      "default": "./resource-daygrid.js"
    },
    "./resource-timegrid": {
      "types": "./resource-timegrid.d.ts",
      "default": "./resource-timegrid.js"
    },
    "./resource-timeline": {
      "types": "./resource-timeline.d.ts",
      "default": "./resource-timeline.js"
    },
    "./scrollgrid": {
      "types": "./scrollgrid.d.ts",
      "default": "./scrollgrid.js"
    },
    "./timeline": {
      "types": "./timeline.d.ts",
      "default": "./timeline.js"
    }
  },
  "sideEffects": [
    "./index.js",
    "./all/index.js",
    "./all/global.js",
    "./adaptive.js",
    "./resource-daygrid.js",
    "./resource-timegrid.js",
    "./resource-timeline.js",
    "./scrollgrid.js",
    "./timeline.js"
  ]
}