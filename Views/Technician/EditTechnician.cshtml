@model ServiceOrderManager.Models.ViewModels.UserTechnicianViewModel

@{
    ViewData["Title"] = "Edit Technician";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Update the Technician</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <form asp-action="EditTechnician" method="post" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-4 shadow-sm">

            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">General Data</h5>
            </div>

            <div class="card-body col-md-12">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Id" class="form-label"></label>
                        <input asp-for="Id" class="form-content form-control" disabled/>
                        <span asp-validation-for="Id" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SelectedUserId" class="form-label"></label>
                        <input asp-for="SelectedUserId" class="form-control" disabled/>
                        <span asp-validation-for="SelectedUserId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" disabled/>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Middlename" class="form-label"></label>
                        <input asp-for="Middlename" class="form-control" disabled />
                        <span asp-validation-for="Middlename" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" disabled />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" disabled />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UserEmail" class="form-label"></label>
                        <input asp-for="UserEmail" class="form-control" disabled />
                        <span asp-validation-for="UserEmail" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" disabled />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="UserRole" class="form-label"></label>
                        <input asp-for="UserRole" class="form-control" disabled />
                        <span asp-validation-for="UserRole" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4 mt-3">
                    <div class="col-md-12">
                        <div class="col-md-12">
                            <label asp-for="Skills" class="form-label"></label>
                            <input asp-for="Skills" class="form-control" />
                            <span asp-validation-for="Skills" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-4 mt-3">
                    <div class="col-md-12">
                        <div class="form-check form-switch card p-3 shadow-sm d-flex align-items-center flex-row justify-content-start gap-3">
                            <input class="form-check-input ms-0 mt-0" asp-for="Enabled" type="checkbox" checked>
                            <label class="form-check-label fw-bold" asp-for="Enabled">
                                Is this Technician ACTIVE?
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer col-md-12">
                 <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-circle"></i> Save Technician
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
