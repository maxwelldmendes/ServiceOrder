@{
}
@model ServiceOrderManager.Models.ViewModels.ClientViewModel

@{
    ViewData["Title"] = "Client Detail";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detalhes do Cliente</h2>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">General Data</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">EINumber</dt>
                <dd class="col-sm-9">@Model.EINumber</dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9">@Model.PrimaryPhone</dd>

                <dt class="col-sm-3">E-mail</dt>
                <dd class="col-sm-9">@Model.PrimaryEmail</dd>
            </dl>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Company Address</h5>
                </div>

                <div class="card-body">
                    <p>@Model.CompanyAddress?.Street1</p>
                    <p>@Model.CompanyAddress?.Street2</p>
                    <p>
                        @Model.CompanyAddress?.City -
                        @Model.CompanyAddress?.State
                    </p>
                    <p>@Model.CompanyAddress?.ZipCode</p>
                    <p>@Model.CompanyAddress?.Country</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Mail Address</h5>
                </div>

                <div class="card-body">
                    <p>@Model.MailAddress?.Street1</p>
                    <p>@Model.MailAddress?.Street2</p>
                    <p>
                        @Model.MailAddress?.City -
                        @Model.MailAddress?.State
                    </p>
                    <p>@Model.MailAddress?.ZipCode</p>
                    <p>@Model.MailAddress?.Country</p>
                </div>
            </div>
        </div>
    </div>
</div>
