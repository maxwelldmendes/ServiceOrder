<div class="container-fluid my-4">
    <div class="card shadow-sm border-0 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary"><i class="bi bi-calendar3"></i> Agenda de Serviços</h2>
            <div>
                <span class="badge bg-primary me-1">Agendado</span>
                <span class="badge bg-success me-1">Confirmado</span>
                <span class="badge bg-secondary me-1">Concluído</span>
                <span class="badge bg-danger">Cancelado</span>
            </div>
        </div>

        <!-- Filtro por Profissional -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-4">
                <label for="filterProfessional" class="form-label fw-bold text-muted small uppercase">Choose the technician</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person-fill"></i></span>
                    <select id="filterProfessional" asp-items="ViewBag.Professionals" class="form-select border-start-0 ps-0">
                        <option value="">-- Todos os Profissionais --</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <!-- O Calendário será renderizado aqui -->
    <div id="calendar" style="min-height: 70vh;">
    </div>
</div>

<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white" id="modalHeader">
                <h5 class="modal-title" id="appointmentModalLabel">🧾 Agendamento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="appointmentForm">
                @Html.AntiForgeryToken()
                <!-- Campo escondido para armazenar o ID quando for edição -->
                <input type="hidden" id="txtId" name="Id" value="0" />

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="ddlClient" class="form-label fw-bold">Client</label>

                        <div class="input-group">
                            <select id="ddlClient"
                                    name="ClientId"
                                    class="form-select"
                                    asp-items="ViewBag.Clients"
                                    required>
                                <option value="">-- Selecione um cliente --</option>
                            </select>

                            <button type="button"
                                    class="btn btn-success"
                                    id="btnNewClient"
                                    title="Cadastrar novo cliente">

                       
                                <i class="bi bi-person-plus"></i>
                                New
                            </button>
                        </div>

                        <span class="text-danger" data-valmsg-for="ClientId"></span>
                    </div>



                    <div class="mb-3">
                        <label class="form-label fw-bold">Título/Serviço</label>
                        <input type="text" id="txtTitle" name="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Profissional Responsável</label>
                        <select id="ddlProfessional" name="AssignedUserId" asp-items="ViewBag.Professionals" class="form-select" required>
                            <option value="">-- Selecione o Profissional --</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Início</label>
                            <input type="datetime-local" id="txtStartTime" name="StartTime" class="form-control" required />
                            
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Término</label>
                            <input type="datetime-local" id="txtEndTime" name="EndTime" class="form-control" required />
                            
                        </div>
                    </div>

                    <!-- Bloco de Status visível apenas na edição -->
                    <div class="mb-3 d-none" id="statusBlock">
                        <label class="form-label fw-bold">Status Atual</label>
                        <select id="ddlStatus" class="form-select">
                            <option value="0">Agendado</option>
                            <option value="1">Confirmado</option>
                            <option value="2">Concluído</option>
                            <option value="3">Cancelado</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Observações</label>
                        <textarea id="txtDescription" name="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <div>
                        <button type="button" id="btnDelete" class="btn btn-danger d-none">Excluir</button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                        <button type="submit" id="btnSave" class="btn btn-primary">Salvar Agendamento</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@*---------------------- Fim do modal appointmentModal -------------------- *@

