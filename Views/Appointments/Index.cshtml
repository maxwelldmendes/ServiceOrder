<div class="container-fluid my-4">
    <div class="card shadow-sm border-0 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary"><i class="bi bi-calendar3"></i> Agenda de Serviços</h2>
            <div>
                <span class="badge bg-primary me-1">Agendado</span>
                <span class="badge bg-success me-1">Confirmado</span>
                <span class="badge bg-secondary me-1">Concluído</span>
                <span class="badge bg-danger">Cancelado</span>
            </div>
        </div>

        <!-- Filtro por Profissional -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-4">
                <label for="filterProfessional" class="form-label fw-bold text-muted small uppercase">Choose the technician</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person-fill"></i></span>
                    <select id="filterProfessional" asp-items="ViewBag.Professionals" class="form-select border-start-0 ps-0">
                        <option value="">-- Todos os Profissionais --</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <!-- O Calendário será renderizado aqui -->
    <div id="calendar" style="min-height: 70vh;">
    </div>
</div>

<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white" id="modalHeader">
                <h5 class="modal-title" id="appointmentModalLabel">🧾 Agendamento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="appointmentForm">
                @Html.AntiForgeryToken()
                <!-- Campo escondido para armazenar o ID quando for edição -->
                <input type="hidden" id="txtId" name="Id" value="0" />

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="ddlClient" class="form-label fw-bold">Client</label>

                        <div class="input-group">
                            <select id="ddlClient"
                                    name="ClientId"
                                    class="form-select"
                                    asp-items="ViewBag.Clients"
                                    required>
                                <option value="">-- Selecione um cliente --</option>
                            </select>

                            <button type="button"
                                    class="btn btn-success"
                                    id="btnNewClient"
                                    title="Cadastrar novo cliente"
                                    onclick="window.location.href='@Url.Action("CreateClient", "Client")'">
                       
                                <i class="bi bi-person-plus"></i>
                                Novo
                            </button>
                        </div>

                        <span class="text-danger" data-valmsg-for="ClientId"></span>
                    </div>



                    <div class="mb-3">
                        <label class="form-label fw-bold">Título/Serviço</label>
                        <input type="text" id="txtTitle" name="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Profissional Responsável</label>
                        <select id="ddlProfessional" name="AssignedUserId" asp-items="ViewBag.Professionals" class="form-select" required>
                            <option value="">-- Selecione o Profissional --</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Início</label>
                            <input type="datetime-local" id="txtStartTime" name="StartTime" class="form-control" required />
                            
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Término</label>
                            <input type="datetime-local" id="txtEndTime" name="EndTime" class="form-control" required />
                            
                        </div>
                    </div>

                    <!-- Bloco de Status visível apenas na edição -->
                    <div class="mb-3 d-none" id="statusBlock">
                        <label class="form-label fw-bold">Status Atual</label>
                        <select id="ddlStatus" class="form-select">
                            <option value="0">Agendado</option>
                            <option value="1">Confirmado</option>
                            <option value="2">Concluído</option>
                            <option value="3">Cancelado</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Observações</label>
                        <textarea id="txtDescription" name="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <div>
                        <button type="button" id="btnDelete" class="btn btn-danger d-none">Excluir</button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                        <button type="submit" id="btnSave" class="btn btn-primary">Salvar Agendamento</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var modalElement = document.getElementById('appointmentModal');

        var modal = modalElement ? new bootstrap.Modal(modalElement) : null;

        var filterDropdown = document.getElementById('filterProfessional');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            contentHeight: 600,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            themeSystem: 'standard',
            selectable: true,
            events: function(fetchInfo, successCallback, failureCallback) {
                var userId = filterDropdown ? filterDropdown.value : '';  // Pega o ID do profissional selecionado no topo

                // Monta a URL passando as datas do calendário e o filtro do usuário
                var url = '/Appointments/GetCalendarEvents?' +
                'start=' + fetchInfo.startStr +
                '&end=' + fetchInfo.endStr +
                '&assignedUserId=' + encodeURIComponent(userId);

                fetch(url)
                .then(response => response.json())
                .then(data => {
                    successCallback(data); // Passa os eventos filtrados para o FullCalendar desenhar
                })
                .catch(error => {
                    console.error('Erro ao buscar eventos:', error);
                    failureCallback(error);
                });
            },
            select: function(info) {
                document.getElementById('appointmentForm').reset();
                document.getElementById('txtId').value = "0";

                // Ajusta visual para criação
                document.getElementById('appointmentModalLabel').innerText = "🧾 Novo Agendamento";
                document.getElementById('statusBlock').classList.add('d-none');
                document.getElementById('btnDelete').classList.add('d-none');
                document.getElementById('btnSave').classList.remove('d-none');
                enableFormFields(true);

                var startIso = info.startStr.includes("T") ? info.startStr.substring(0, 16) : info.startStr + "T08:00";
                var endIso = info.endStr.includes("T") ? info.endStr.substring(0, 16) : info.startStr + "T09:00";

                document.getElementById('txtStartTime').value = startIso;
                document.getElementById('txtEndTime').value = endIso;
                modal.show();
            },

            // 2. CLIQUE EM UM AGENDAMENTO EXISTENTE (DETALHES / ALTERAÇÃO)
            eventClick: function(info) {
                var id = info.event.id;

                fetch('/Appointments/GetDetails/' + id)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Não foi possível carregar o agendamento.');
                    }

                    return response.json();
                })
                .then(data => {
                    document.getElementById('txtId').value = data.id;
                    document.getElementById('ddlClient').value = data.clientId;

                    document.getElementById('txtTitle').value = data.title;
                    document.getElementById('ddlProfessional').value = data.assignedUserId;
                    document.getElementById('txtStartTime').value = data.startTime;
                    document.getElementById('txtEndTime').value = data.endTime;
                    document.getElementById('txtDescription').value = data.description;

                    var status = Number(data.status);

                    document.getElementById('ddlStatus').value = status;

                    // Ajusta visual para detalhes/edição
                    document.getElementById('appointmentModalLabel').innerText =
                    "🔍 Detalhes do Agendamento";

                    document.getElementById('statusBlock').classList.remove('d-none');
                    document.getElementById('btnDelete').classList.remove('d-none');

                    if (status === 2 || status === 3) {
                        enableFormFields(false);
                        document.getElementById('btnSave').classList.add('d-none');
                    } else {
                        enableFormFields(true);
                        document.getElementById('btnSave').classList.remove('d-none');
                    }
                    modal.show();
                })
                .catch(error => {
                    console.error(error);
                    alert(error.message);
                });

            }
        });

        calendar.render();
        // ESCUTA O FILTRO: Quando mudar o profissional no topo, força o calendário a recarregar
        if (filterDropdown) {
            filterDropdown.addEventListener('change', function () {
                calendar.refetchEvents();
            });
        }

        function enableFormFields(enable) {
            var fields = [
            'ddlClient',
            'txtTitle',
            'ddlProfessional',
            'txtStartTime',
            'txtEndTime',
            'txtDescription'
            ];

            fields.forEach(function(id) {
                document.getElementById(id).disabled = !enable;
            });
        }

        // 3. EVENTO DE SUBMIT (SALVAR NOVO OU ALTERAR STATUS DE EXISTENTE)
        document.getElementById('appointmentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            var id = document.getElementById('txtId').value;

            // Se o ID for maior que 0, trata-se de uma atualização de Status
            if (id !== "0") {
                var formData = new FormData(this);

                formData.append('actionType', 'update');
                formData.append(
                'status',
                document.getElementById('ddlStatus').value
                );

                fetch('/Appointments/UpdateStatusOrDelete', {
                    method: 'POST',
                    body: formData
                })
                .then(async response => {
                    var data = await response.json();

                    if (!response.ok) {
                        throw new Error(
                        data.message || 'Erro ao atualizar o agendamento.'
                        );
                    }

                    return data;
                })
                .then(data => {
                    //alert(data.message);

                    if (data.success) {
                        modal.hide();
                        calendar.refetchEvents();
                    }
                })
                .catch(error => {
                    console.error(error);
                    alert(error.message);
                });

            } else {
                // Criação convencional
                var formData = new FormData(this);
                fetch('/Appointments/Create', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    //alert(data.message);
                    if (data.success) { modal.hide(); calendar.refetchEvents(); }
                });
            }
        });

        // 4. BOTÃO EXCLUIR
        document.getElementById('btnDelete').addEventListener('click', function() {
            if (confirm("Tem certeza que deseja excluir em definitivo este agendamento?")) {
                var id = document.getElementById('txtId').value;
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var formData = new FormData();
                formData.append('id', id);
                formData.append('actionType', 'delete');
                formData.append('__RequestVerificationToken', token);

                fetch('/Appointments/UpdateStatusOrDelete', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    //alert(data.message);
                    if (data.success) { modal.hide(); calendar.refetchEvents(); }
                });
            }
        });
    });

</script>
