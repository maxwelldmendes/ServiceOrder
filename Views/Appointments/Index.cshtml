<!-- Modal de Novo Cliente -->
<div class="modal fade" id="novoClienteModal" tabindex="-1"
     aria-labelledby="novoClienteModalLabel" aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="novoClienteModalLabel">
                    Novo Cliente
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>
            </div>

            <div class="modal-body">


                Conteúdo do modal aqui...
            </div>

        </div>
    </div>
</div>

<script
  src="https://code.jquery.com/jquery-4.0.0.slim.js"
  integrity="sha256-M+GjhMBfXikM1izMplICCTscIj5hzPCp6uDzaypxtgg="
  crossorigin="anonymous">
</script>



@*-------------------Fim do modal novo cliente ------------------------*@
<script>
document.addEventListener('DOMContentLoaded', function () {
    const botaoAbrir = document.getElementById('btnNewClient');
    const modalElement = document.getElementById('novoClienteModal');

    if (!botaoAbrir || !modalElement) {
        console.error('Botão ou modal não encontrado.');
        return;
    }

    const modalNovoCliente = new bootstrap.Modal(modalElement);

    botaoAbrir.addEventListener('click', function () {
        modalNovoCliente.show();
    });
});

</script>


<script>
    $(function () {
        const calendarEl = $('#calendar')[0];
        const modalElement = $('#appointmentModal')[0];
        const modal = modalElement
            ? new bootstrap.Modal(modalElement)
            : null;

        const $filterDropdown = $('#filterProfessional');

        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            contentHeight: 600,

            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
            },

            themeSystem: 'bootstrap5',
            selectable: true,

            events: function (fetchInfo, successCallback, failureCallback) {
                const userId = $filterDropdown.length
                    ? $filterDropdown.val()
                    : '';

                $.ajax({
                    url: '/Appointments/GetCalendarEvents',
                    type: 'GET',
                    data: {
                        start: fetchInfo.startStr,
                        end: fetchInfo.endStr,
                        assignedUserId: userId
                    },
                    success: successCallback,
                    error: function (xhr) {
                        console.error('Erro ao buscar eventos:', xhr);
                        failureCallback(xhr);
                    }
                });
            },

            select: function (info) {
                $('#appointmentForm')[0].reset();

                $('#txtId').val('0');
                $('#appointmentModalLabel').text('🧾 Novo Agendamento');

                $('#statusBlock').addClass('d-none');
                $('#btnDelete').addClass('d-none');
                $('#btnSave').removeClass('d-none');

                enableFormFields(true);

                const startIso = info.startStr.includes('T')
                    ? info.startStr.substring(0, 16)
                    : info.startStr + 'T08:00';

                const endIso = info.endStr.includes('T')
                    ? info.endStr.substring(0, 16)
                    : info.startStr + 'T09:00';

                $('#txtStartTime').val(startIso);
                $('#txtEndTime').val(endIso);

                modal.show();
            },

            eventClick: function (info) {
                const id = info.event.id;

                $.ajax({
                    url: '/Appointments/GetDetails/' + id,
                    type: 'GET',
                    dataType: 'json',

                    success: function (data) {
                        $('#txtId').val(data.id);
                        $('#ddlClient').val(data.clientId);
                        $('#txtTitle').val(data.title);
                        $('#ddlProfessional').val(data.assignedUserId);
                        $('#txtStartTime').val(data.startTime);
                        $('#txtEndTime').val(data.endTime);
                        $('#txtDescription').val(data.description);

                        const status = Number(data.status);
                        $('#ddlStatus').val(status);

                        $('#appointmentModalLabel')
                            .text('🔍 Detalhes do Agendamento');

                        $('#statusBlock').removeClass('d-none');
                        $('#btnDelete').removeClass('d-none');

                        if (status === 2 || status === 3) {
                            enableFormFields(false);
                            $('#btnSave').addClass('d-none');
                        } else {
                            enableFormFields(true);
                            $('#btnSave').removeClass('d-none');
                        }

                        modal.show();
                    },

                    error: function (xhr) {
                        console.error(xhr);
                        alert('Não foi possível carregar o agendamento.');
                    }
                });
            }
        });

        calendar.render();

        // Filtro de profissional
        $filterDropdown.on('change', function () {
            calendar.refetchEvents();
        });

        function enableFormFields(enable) {
            const fields = [
                '#ddlClient',
                '#txtTitle',
                '#ddlProfessional',
                '#txtStartTime',
                '#txtEndTime',
                '#txtDescription'
            ];

            fields.forEach(function (selector) {
                $(selector).prop('disabled', !enable);
            });
        }

        // Submit do formulário
        $('#appointmentForm').on('submit', function (e) {
            e.preventDefault();

            const form = this;
            const id = $('#txtId').val();
            const formData = new FormData(form);

            let url;

            if (id !== '0') {
                url = '/Appointments/UpdateStatusOrDelete';

                formData.append('actionType', 'update');
                formData.append('status', $('#ddlStatus').val());
            } else {
                url = '/Appointments/Create';
            }

            $.ajax({
                url: url,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',

                success: function (data) {
                    if (data.success) {
                        modal.hide();
                        calendar.refetchEvents();
                    } else {
                        alert(data.message || 'Não foi possível salvar.');
                    }
                },

                error: function (xhr) {
                    console.error(xhr);

                    const message =
                        xhr.responseJSON?.message ||
                        'Erro ao processar a operação.';

                    alert(message);
                }
            });
        });

        // Excluir agendamento
        $('#btnDelete').on('click', function () {
            if (!confirm(
                'Tem certeza que deseja excluir em definitivo este agendamento?'
            )) {
                return;
            }

            const id = $('#txtId').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            const formData = new FormData();
            formData.append('id', id);
            formData.append('actionType', 'delete');
            formData.append('__RequestVerificationToken', token);

            $.ajax({
                url: '/Appointments/UpdateStatusOrDelete',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',

                success: function (data) {
                    if (data.success) {
                        modal.hide();
                        calendar.refetchEvents();
                    } else {
                        alert(data.message || 'Erro ao excluir.');
                    }
                },

                error: function (xhr) {
                    console.error(xhr);
                    alert('Erro ao excluir o agendamento.');
                }
            });
        });
    });
</script>

