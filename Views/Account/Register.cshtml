@model ServiceOrderManager.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registrar Novo Usuário";
}

<div class="container d-flex justify-content-center align-items-center my-5">
    <div class="card shadow-sm" style="width: 100%; max-width: 600px; border-radius: 10px;">
        <div class="card-body p-4">
            <h3 class="text-center mb-4 text-primary">Registrar Novo Usuário</h3>
            <p class="text-muted text-center small">Apenas administradores podem realizar esta operação.</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="FirstName" class="form-label font-weight-bold"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="MiddleName" class="form-label font-weight-bold"></label>
                        <input asp-for="MiddleName" class="form-control" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="LastName" class="form-label font-weight-bold"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label font-weight-bold"></label>
                    <input asp-for="Email" class="form-control" placeholder="usuario@empresa.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="UserRole" class="form-label font-weight-bold"></label>
                    <select asp-for="UserRole" asp-items="ViewBag.Roles" class="form-select">
                        <option value="">-- Selecione o Perfil --</option>
                    </select>
                    <span asp-validation-for="UserRole" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Password" class="form-label font-weight-bold"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="ConfirmPassword" class="form-label font-weight-bold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 row">
                    <div class="col-6">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100">Cancelar</a>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary w-100">Cadastrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
