@using Microsoft.AspNetCore.Components.Rendering
@using ServiceOrderManager.Models.ViewModels
@model ServiceOrderManager.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    ViewData["IsLoginPage"] = true;
}

<div class="container">
    <div class="card shadow-sm mx-auto"
         style="width: 100%; max-width: 400px; border-radius: 10px;">

        <div class="card-body p-4">
            <h3 class="text-center mb-4 text-primary">
                Acessar Conta
            </h3>

            <form asp-action="Login"
                  asp-route-returnurl="@ViewData["ReturnUrl"]"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="exemplo@email.com" />
                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Senha" class="form-label fw-bold"></label>
                    <input asp-for="Senha"
                           type="password"
                           class="form-control"
                           placeholder="Sua senha" />
                    <span asp-validation-for="Senha"
                          class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="LembrarMe"
                           class="form-check-input" />

                    <label asp-for="LembrarMe"
                           class="form-check-label text-muted small">
                    </label>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100 py-2 mb-3">
                    Entrar
                </button>
            </form>

            <div class="text-center d-flex justify-content-between">
                <a href="#"
                   class="text-decoration-none small text-muted">
                    Esqueceu a senha?
                </a>

                <a asp-action="Register"
                   class="text-decoration-none small text-primary">
                    Criar uma conta
                </a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
